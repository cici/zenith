{
  "info": {
    "name": "Zenith Auth API",
    "description": "Collection for testing Supabase authentication endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Sign Up",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{SUPABASE_ANON_KEY}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"test@example.com\",\n    \"password\": \"SecurePassword123!\",\n    \"data\": {\n        \"full_name\": \"Test User\"\n    }\n}"
            },
            "url": {
              "raw": "{{SUPABASE_URL}}/auth/v1/signup",
              "host": ["{{SUPABASE_URL}}"],
              "path": ["auth", "v1", "signup"]
            },
            "description": "Create a new user account"
          }
        },
        {
          "name": "Sign In",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{SUPABASE_ANON_KEY}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"test@example.com\",\n    \"password\": \"SecurePassword123!\"\n}"
            },
            "url": {
              "raw": "{{SUPABASE_URL}}/auth/v1/token?grant_type=password",
              "host": ["{{SUPABASE_URL}}"],
              "path": ["auth", "v1", "token"],
              "query": [
                {
                  "key": "grant_type",
                  "value": "password"
                }
              ]
            },
            "description": "Sign in with email and password"
          }
        },
        {
          "name": "Get User",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "apikey",
                "value": "{{SUPABASE_ANON_KEY}}",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{ACCESS_TOKEN}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{SUPABASE_URL}}/auth/v1/user",
              "host": ["{{SUPABASE_URL}}"],
              "path": ["auth", "v1", "user"]
            },
            "description": "Get the current user's details"
          }
        },
        {
          "name": "Reset Password Request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{SUPABASE_ANON_KEY}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"test@example.com\"\n}"
            },
            "url": {
              "raw": "{{SUPABASE_URL}}/auth/v1/recover",
              "host": ["{{SUPABASE_URL}}"],
              "path": ["auth", "v1", "recover"]
            },
            "description": "Request a password reset email"
          }
        },
        {
          "name": "Update User",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "apikey",
                "value": "{{SUPABASE_ANON_KEY}}",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{ACCESS_TOKEN}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"newemail@example.com\",\n    \"data\": {\n        \"full_name\": \"Updated Name\"\n    }\n}"
            },
            "url": {
              "raw": "{{SUPABASE_URL}}/auth/v1/user",
              "host": ["{{SUPABASE_URL}}"],
              "path": ["auth", "v1", "user"]
            },
            "description": "Update user details"
          }
        },
        {
          "name": "Sign Out",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{SUPABASE_ANON_KEY}}",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{ACCESS_TOKEN}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{SUPABASE_URL}}/auth/v1/logout",
              "host": ["{{SUPABASE_URL}}"],
              "path": ["auth", "v1", "logout"]
            },
            "description": "Sign out the current user"
          }
        }
      ]
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [""]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.response.code === 200 || pm.response.code === 201) {",
          "    if (pm.response.json().access_token) {",
          "        pm.environment.set('ACCESS_TOKEN', pm.response.json().access_token);",
          "    }",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "SUPABASE_URL",
      "value": "your_supabase_project_url"
    },
    {
      "key": "SUPABASE_ANON_KEY",
      "value": "your_supabase_anon_key"
    }
  ]
} 